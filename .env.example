# Hugging Face cache outside the user profile (Cyrillic path) and outside Nextcloud
HF_HOME=C:\hf_cache
HF_HUB_DISABLE_XET=1

# Torch CPU threads (Ryzen 3 4300U: 4 cores)
TORCH_NUM_THREADS=4

# PostgreSQL (filled in when the DB from the ETL part is ready)
DATABASE_URL=postgresql+psycopg://invest:invest@localhost:5432/invest
