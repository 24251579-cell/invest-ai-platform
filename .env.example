# Hugging Face cache
HF_HOME=/home/vkotov/hf_cache
HF_HUB_DISABLE_XET=1
TORCH_NUM_THREADS=4
# Local RuBERT/FinBERT copies; overrides sentiment.local_models_dir from settings.yaml
LOCAL_MODELS_DIR=/home/vkotov/hf_models

# PostgreSQL
# Host / CLI (порт проброшен из docker compose):
DATABASE_URL=postgresql+psycopg://invest:invest@localhost:5432/invest
# В контейнере invest-ai URL переопределяется на @db:5432 через docker-compose.yml
# Auto CSV→Postgres after load_candles / load_news / score_sentiment / predict:
AUTO_SYNC_DB=1
